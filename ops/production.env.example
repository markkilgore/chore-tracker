APP_IMAGE_TAG=bootstrap
APP_ORIGIN=http://127.0.0.1:8788

# Use 127.0.0.1 for host-only access, or the NUC's reserved LAN IP for direct
# access from family devices. Do not use 0.0.0.0 unless that is intentional.
TIDY_BIND_ADDRESS=127.0.0.1
TIDY_HOST_PORT=8788

# Production paths on the NUC. The production checkout is pull-only; none of
# these paths are shared with the development checkout.
TIDY_DATA_DIR=/srv/tidy-week/data
TIDY_ASSETS_DIR=/srv/tidy-week/assets
TIDY_BACKUP_DIR=/srv/tidy-week/backups
TIDY_BACKUP_RETENTION=14
TIDY_DATA_GID=1000

# Optional off-box copy. Local snapshots alone are not disaster recovery.
# RESTIC_REPOSITORY=/mnt/offsite/chore-tracker
# RESTIC_PASSWORD_FILE=/etc/tidy-week/restic-password
